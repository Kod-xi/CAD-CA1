{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "Actor": {
            "additionalProperties": false,
            "properties": {
                "actorId": {
                    "type": "number"
                },
                "bio": {
                    "type": "string"
                },
                "dateOfBirth": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "actorId",
                "bio",
                "dateOfBirth",
                "name"
            ],
            "type": "object"
        },
        "Movie": {
            "additionalProperties": false,
            "properties": {
                "movieId": {
                    "type": "number"
                },
                "overview": {
                    "type": "string"
                },
                "releaseDate": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            },
            "required": [
                "movieId",
                "overview",
                "releaseDate",
                "title"
            ],
            "type": "object"
        },
        "Role": {
            "additionalProperties": false,
            "properties": {
                "actorId": {
                    "type": "number"
                },
                "movieId": {
                    "type": "number"
                },
                "roleDescription": {
                    "type": "string"
                },
                "roleName": {
                    "type": "string"
                }
            },
            "required": [
                "actorId",
                "movieId",
                "roleDescription",
                "roleName"
            ],
            "type": "object"
        }
    }
}
